	<xs:complexType name="DltPlatformOperationalInformation">
		<xs:sequence>
			<xs:element name="Type" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Type</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the name of the underlying platform used in the design and operation of the DLT and covers a range of services including in the platform such as accessibility, consensus mechanism, and governance. e.g. Ethereum, Hyperledger Besu, Hyperledger Fabric. This is a free text field that users can populate with their specific description.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Accessibility" type="DltPlatformAcessibilityType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Accessibility</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Accessibility describes the scope of participants and whether participants' access is restricted. A Public ledger, also known as the non-permissioned ledger, allows anyone to create and validate blocks as well as to modify the ledger state by storing and updating data by means of transactions among participating entities. Private ledgers are restricted to specific users or entities to modify the ledger and view transactions on the ledger. Permissioned ledgers are a hybrid of public and private, such that only authorised and trusted entities can view and participate in the activities within the ledger.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Role" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Role</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The Role element describes the activities and services performed by the platform as described in the offering documents. The role type allows for a free text description of one or more roles but also allows the use of a link to a specific role as defined in the partyRole group. Typical roles performed by a DLT platform include registrar, account keeper, custodian and settlement agent.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Operator" type="PlatformOperator" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Operator</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The operator of a DLT platform will depend on the type of platform and accessibility. In a private ledger there may be one operator. In a consortium there will be more than one operator. In a public network, no operator will be defined instead the operator element will be set to Distributed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Name" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Name</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The public or commercial name assigned to the platform.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Fee" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">FeeDescription</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">A description of the fees (if applicable) charged by the platform, how they are calculated and distributed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identifier" type="PlatformIdentifier" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Identifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">One or more identifiers assigned to the platform that may include a MIC, LEI, DTI or custom identifier.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TokenType" type="xs:string" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TokenType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The type of token(s) used on the platform. This is a free text field that allows for multiple tokens.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TokenTechnicalReference" type="xs:string" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TokenTechnicalReference</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">One or more technical reference documents and specifications of the token(s).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TokenTechnicalReferenceIdentifier" type="xs:string" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TokenTechnicalReferenceIdentifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identifiers of the technical specifications reference in the TokenTechnicalReference tag.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SmartContract" type="xs:string" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SmartContract</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The smart contract identifier used by the platform in reference to the token type and purpose of the platform.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Series">
