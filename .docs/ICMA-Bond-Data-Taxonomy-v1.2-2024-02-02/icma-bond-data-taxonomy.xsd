				</xs:annotation>
			</xs:element>
			<xs:element name="TermPeriod" type="TermPeriod" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TermPeriod</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Term period of the index/benchmark. Only required when term period defined. The term period shall be expressed in days, weeks, months or years.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
