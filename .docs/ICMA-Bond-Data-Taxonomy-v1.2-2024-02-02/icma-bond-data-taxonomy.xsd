			<xs:element name="Operator" type="xs:IDREF" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Operator</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The party responsible for operation of the platform. This field is a link to the party defined in the party block.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Decentralised" type="xs:boolean" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>