<xs:schema xmlns="urn:icma:xsd:ICMABondDataTaxonomy" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:icma:xsd:ICMABondDataTaxonomy" elementFormDefault="qualified" version="1.2">
	<xs:include schemaLocation="./icma-bond-data-taxonomy-enums.xsd"/>
	<xs:include schemaLocation="./icma-bond-data-taxonomy-isotypes.xsd"/>
	<xs:element name="Document" type="Document">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ICMABondDataTaxonomy</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">XML specification of ICMA Bond Data Taxonomy.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!-- Document definition-->
	<xs:complexType name="Document">
		<xs:sequence>
			<xs:element name="ICMABondDataTaxonomy" type="ICMABondDataTaxonomy"/>
		</xs:sequence>
	</xs:complexType>
	<!--ICMA Bond Data Taxonomy-->
	<xs:complexType name="ICMABondDataTaxonomy">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ICMABondDataTaxonomy</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">XML specification of ICMA Bond Data Taxonomy.</xs:documentation>
		</xs:annotation>
		<!--Parties to the issuance-->
		<xs:sequence>
			<xs:element name="PartyRole" type="PartyRole" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PartyRole</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The role of the party as defined by the enumeration list.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Party" type="Party" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Party</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The name, LEI and other details of the party.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<!--Details of the Issuance-->
			<xs:element name="Issuance" type="Issuance" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Issuance</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The complex xml type that defines the details of a new issuance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<!--Details of the Product-->
			<xs:element name="Product" type="Product" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Product</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The complex xml type that defines the details of a new issuance security.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--PartyRole Definition-->
	<xs:complexType name="PartyRole">
		<xs:sequence>
			<xs:element name="PartyRoleType" type="PartyRoleType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="PartyRoleOtherType" type="xs:string" minOccurs="0" maxOccurs="1"/>
			<xs:element name="PartyID">
				<xs:complexType>
					<xs:attribute name="PID" type="xs:IDREF"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Party Definition-->
	<xs:complexType name="Party">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">Party</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">The name, LEI and other details of the party.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PartyName" type="LEIName" minOccurs="1" maxOccurs="1">
				</xs:element>
			<xs:element name="LEIIdentifier" type="LEIIdentifier" minOccurs="1" maxOccurs="1">
				</xs:element>
			<xs:element name="BloombergTicker" type="BloombergTicker" minOccurs="0" maxOccurs="1">
				</xs:element>
			<xs:element name="PartyRating" type="RatingGroup" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PartyRating</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The credit rating assigned to the party.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="PID" type="xs:ID"/>
	</xs:complexType>
	<!--Issuance Definition-->
	<xs:complexType name="Issuance">
		<xs:sequence>
			<xs:element name="IssuanceType" type="IssuanceType" minOccurs="1" maxOccurs="1">
			</xs:element>
			<xs:element name="SpecifiedDenomination" type="xs:decimal" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SpecifiedDenomination</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Minimum denomination.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IntegralMultiples" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">IntegralMultiples</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Smallest amount by which the minimum denomination can be increased.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CalculationAmount" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CalculationAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The amount used for calculation of interest and redemption amounts.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EarlyRedemptionAmountPercentage" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
			<xs:element name="FinalRedemptionAmountPercentage" type="xs:decimal" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ChangeOfInterestPaymentBasis" type="xs:string" minOccurs="0" maxOccurs="1"/>
			<xs:element name="SpecifiedCurrency" type="ISOCurrencyCode" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SpecifiedCurrency</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Currency of the nominal value of the issuance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PaymentCurrency" type="ISOCurrencyCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PaymentCurrency</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Currency for interest payments. Only if payment currency differs from Specified Currency.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SettlementCurrency" type="ISOCurrencyCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SettlementCurrency</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Currency for settlement. Only if settlement currency differs from Specified Currency.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PricingDate" type="ISODate" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PricingDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The date the transaction is priced ahead of issuance. Also referred to as trade date for private placements.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IssueDate" type="ISODate" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">IssueDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The date when the security legally comes into existence and typically falls in line with settlement date and interest commencement date. Also referred to as closing date (though historically different).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SettlementDate" type="ISODate" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SettlementDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">When investors receive notes in exchange for the issuer receiving net proceeds.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IssuePrice" type="Price" minOccurs="1" maxOccurs="1"/>
			<xs:element name="IndicationOfYield" type="Price" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ReofferPrice" type="Price" minOccurs="0" maxOccurs="1"/>
			<xs:element name="ReofferYield" type="Price" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="Benchmark" type="Security" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Benchmark</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The benchmark bond used to price the note.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReofferSpreadToBenchmark" type="Price" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="MidSwapRate" type="Price" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="ReofferSpreadtoMidSwapRate" type="Price" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="Fee" type="FeeWithAllocation" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">FeeWithAllocation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Fees payable to managers/dealers. Expressed as a percentage of nominal amount. Also referred to as commissions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Proceeds" type="Proceeds" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="AllIn" type="PriceYieldDiscount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">AllInPYD</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The price after deducting any costs to the issuer.</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The yield after deducting any costs to the issuer.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Listing" type="Listing" minOccurs="1" maxOccurs="unbounded"/>
			<xs:element name="ClearingSettlementSystem" type="ClearingSettlementSystemType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="DltPlatform" type="DltPlatformOperationalInformation" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="MethodOfDistribution" type="DistributionMethod" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="GoverningLaw" type="GoverningLaw" minOccurs="1" maxOccurs="1">
			</xs:element>
			<xs:element name="Expenses" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Expenses</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Description of commercial arrangements for expenses, ie ‘Issuer pays legal fees’, ‘Lead Manager pays listing expenses’.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Documentation" type="Documentation" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="SellingRestrictions" type="SellingRestrictionType" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SellingRestrictions</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Categories of potential investors to which the notes are offered.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRIIPsRestriction" type="PRIIPsRestriction" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PRIIPs</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Any prohibition of sales to EEA and/or UK retail investors pursuant to the EEA and/or UK PRIIPs Regulation.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AdditionalSellingRestrictions" type="xs:string" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="ManufacturerTargetMarket" type="ManufacturerTargetMarketType" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ManufacturerTargetMarket</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The target market assessment in respect of the notes and which channels for distribution of the notes are appropriate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NegativePledge" type="Applicability" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="GrossUp" type="Applicability" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="CrossDefault" type="Applicability" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="SubstitutionOrVariation" type="Applicability" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SubstitutionOrVariation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication of whether the terms and conditions of the note provide for a substitution or variation. Basic indication (not including any detail). </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CallPutOption" type="CallPutOptionType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CallPutOption</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN"></xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OptionalRedemption" type="OptionalRedemption" minOccurs="0" maxOccurs="unbounded">
			</xs:element>
			<xs:element name="RedemptionPaymentBasis" type="RedemptionPaymentBasisType" minOccurs="0" maxOccurs="unbounded">
			</xs:element>
			<xs:element name="YieldToCall" type="Price" minOccurs="0" maxOccurs="1">
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Product Definition-->
	<xs:complexType name="Product">
		<xs:sequence>
			<xs:element name="SecurityIdentifierList" type="SecurityIdentifierList" minOccurs="0" maxOccurs="1"/>
			<xs:element name="Series" type="Series" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Tranche" type="Tranche" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="FormOfNote" type="FormOfNote" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">FormOfNote</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Whether Bearer, Registered, or other formats.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StatusOfNote" type="StatusOfNote" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">StatusOfNote</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Captures information relating to the seniority of the note.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AggregateNominalAmount" type="xs:decimal" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">AggregateNominalAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Aggregate nominal amount on issue of the initial tranche.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OutstandingAmountBeforeIncrease" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">OutstandingAmountBeforeIncrease</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Aggregate nominal amount outstanding following any prior fungible tranches (taps).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OutstandingAmountAfterIncrease" type="xs:decimal" minOccurs="0" maxOccurs="1">

			</xs:element>
			<xs:element name="ExpectedProductRating" type="RatingGroup" minOccurs="0" maxOccurs="1"/>
			<xs:element name="MaturityDate" type="ISODate" minOccurs="1" maxOccurs="1">

			</xs:element>
			<xs:element name="InterestPayment" type="InterestPayment" minOccurs="1" maxOccurs="1">

			</xs:element>
			<xs:element name="DayCountFraction" type="DayCountFraction" minOccurs="1" maxOccurs="1">

			</xs:element>
			<xs:element name="BusinessDayConvention" type="BusinessDayConvention" minOccurs="1" maxOccurs="1"/>
			<xs:element name="BusinessDayCenter" type="BusinessDayCenter" minOccurs="1" maxOccurs="1"/>
			<xs:element name="Optionality" type="OptionType" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="Taxonomy" type="Taxonomy" minOccurs="0" maxOccurs="unbounded">
			</xs:element>
			<xs:element name="DLTBondIndicator" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DLTBondIndicator</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication of whether the bond is issued on a distributed ledger. See also ICMA FAQs on DLT and blockchain in bond markets. </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Bloomberg Party Definition-->
	<xs:simpleType name="BloombergTicker">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">BloombergTicker</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Ticker assigned by Bloomberg to the party.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="140"/>
		</xs:restriction>
	</xs:simpleType>
	<!--Rating Definition-->
	<xs:complexType name="Rating">
		<xs:sequence>
			<xs:element name="RatingAgency" type="RatingAgency" minOccurs="1" maxOccurs="1">
				</xs:element>
			<xs:element name="RatingValue" type="RatingValue" minOccurs="1" maxOccurs="1">
				</xs:element>
			<xs:element name="RatingOutlook" type="RatingOutlook" minOccurs="0" maxOccurs="1">
				</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="RatingValue">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">RatingValue</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Rating value assigned by the ratings agency.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
		</xs:restriction>
	</xs:simpleType>
	<!--Rating Group-->
	<xs:complexType name="RatingGroup">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">RatingGroup</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">A list of one or more ratings assigned by rating agencies to an entity or security.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Rating" type="Rating" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<!--Security Definition-->
	<xs:complexType name="Security">
		<xs:sequence>
			<xs:element name="Identifier" type="SecurityIdentifier" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SecurityIdentifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">An identifier assigned to a security as defined by the service provider of the identifer such as ISIN and CUSIP.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Ticker" type="SecurityTicker" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Ticker</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The ticker of the security used to price the note, eg DBR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaturityDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MaturityDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN"></xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterestRate" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InterestRate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Rate of fixed interest payments. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Price" type="PriceYieldDiscount" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<!--Security Identifier Definition-->
	<xs:complexType name="SecurityIdentifier">
		<xs:sequence>
			<xs:choice>
				<xs:element name="ISIN" type="ISINOct2015Identifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">ISIN</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">The International Securities Identification Number is a code allocated to financial instruments as well as referential instruments, as described in the ISO 6166 standard, associated with the minimum descriptive data.  The ISIN consists of a prefix using the alpha-2 country codes or reserved codes specified in ISO 3166 or other prefixes as may be determined by the Registration Authority for the ISO 6166 standard, a nine characters (alphanumeric) basic code and a check digit.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="CUSIP" type="CUSIPIdentifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">CUSIP</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Committee on Uniform Securities and Identification Procedures (CUSIP). The standards body that created and maintains the securities classification system in the US. Non-US securities have a similar number called the CINS number.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="SEDOL" type="SEDOLIdentifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">SEDOL</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Stock Exchange Daily Official List (SEDOL) number. A code used by the London Stock Exchange to identify foreign stocks, especially those that aren't actively traded in the US and don't have a CUSIP number.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="COMMON_CODE" type="COMMON_CODEIdentifier" minOccurs="0" maxOccurs="1">
				</xs:element>
				<xs:element name="WKN" type="WKNIdentifier" minOccurs="0" maxOccurs="1">
				</xs:element>
				<xs:element name="DTI" type="DTI2021Identifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">DTI</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">The Digital Token Identifier (DTI) is an 8 character code assigned to fungible digital assets which uses distributed ledger technology for its issuance, storage, exchange, record of ownership or transaction validation and is not a currency (ISO 4217) as described in ISO 24165 - DTI. A check character, using the same character set as the base number, shall be calculated and added.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:choice>
